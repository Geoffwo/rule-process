{
  "name": "rule-process",
  "version": "1.6.1",
  "description": "file rule processing tool",
  "bin": {
    "rule-process": "./src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README-zh.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoffwo/file-rule-process.git"
  },
  "homepage": "https://gitee.com/Geoffwo/file-rule-process.git#readme",
  "pkg": {
    "assets": [
      "src/examples/**/*",

      "node_modules/vosk/lib/**/*",
      "node_modules/vosk/index.js",
      "node_modules/vosk/package.json",

      "node_modules/ffi-napi/lib/**/*",
      "node_modules/ffi-napi/prebuilds/**/*",
      "node_modules/ffi-napi/index.js",
      "node_modules/ffi-napi/package.json",

      "node_modules/ref-napi/lib/**/*",
      "node_modules/ref-napi/prebuilds/**/*",
      "node_modules/ref-napi/index.js",
      "node_modules/ref-napi/package.json",

      "node_modules/ref-struct-di/lib/**/*",
      "node_modules/ref-struct-di/index.js",
      "node_modules/ref-struct-di/package.json",

      "node_modules/node-gyp-build/index.js",
      "node_modules/node-gyp-build/package.json",

      "node_modules/debug/src/**/*",
      "node_modules/debug/package.json",
      "node_modules/ms/index.js",
      "node_modules/ms/package.json"
    ],
    "scripts": [],
    "targets": [
      "node18-win-x64",
      "node18-linux-x64",
      "node18-macos-x64"
    ]
  },
  "scripts": {
    "build": "npm run build:pkg & npm run build:rewrite",
    "build:pkg": "pkg . --out-path ./dist",
    "build:pkg:debug": "pkg . --out-path ./dist --debug",
    "build:rewrite": "node ./config/build-rewrite.js",
    "link:local": "npm link",
    "link:unlink": "npm unlink",
    "test:cli": "rule-process -v",
    "start": "rule-process -s",
    "start:init": "rule-process init",
    "start:run": "rule-process run",
    "registry:npm": "npm config set registry https://registry.npmjs.org/",
    "registry:mirror": "npm config set registry https://registry.npmmirror.com/",
    "login:npm": "npm run registry:npm & npm login",
    "version:patch": "npm version patch",
    "package:copy": "node ./config/copyPackage.js",
    "package:restore": "node config/restorePackage.js",
    "publish:all": "npm run package:copy & npm publish & npm run package:restore",
    "unpublish:force": "npm unpublish rule-process@1.3.0 --force",
    "install:vosk": "nvm use 14.18.0 & npm install vosk & nvm use 18.20.4"
  },
  "keywords": [
    "cli",
    "file-processing",
    "rules-engine",
    "file-conversion",
    "command-line-tool",
    "build-tool",
    "automation",
    "file-management",
    "rule-based-processing",
    "productivity"
  ],
  "engines": {
    "node": ">=18.20.4"
  },
  "author": "geoffwo",
  "license": "ISC",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0",
    "acorn": "^8.14.1",
    "acorn-walk": "^8.3.4",
    "axios": "^0.27.2",
    "commander": "^11.1.0",
    "fs-extra": "^11.3.0",
    "ini": "^5.0.0",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3",
    "semver": "^7.7.1",
    "vosk": "^0.3.39"
  },
  "dependencies": {
  }
}
